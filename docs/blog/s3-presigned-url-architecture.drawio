  <diagram id="s3-presigned-url" name="S3 Presigned URL">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="UPLOAD TRỰC TIẾP LÊN AMAZON S3 BẰNG PRESIGNED URL" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#172B4D;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="38" width="1280" height="46" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Backend xác thực người dùng và cấp URL có thời hạn; trình duyệt dùng URL đó để gửi file thẳng đến S3." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#5D6E84;fontSize=16;" vertex="1" parent="1"><mxGeometry x="57" y="88" width="1280" height="32" as="geometry"/></mxCell>
        <mxCell id="cloud" value="AWS CLOUD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFE;strokeColor=#AAB9CE;strokeWidth=1.5;dashed=1;dashPattern=8 5;arcSize=12;fontColor=#42536B;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="350" y="180" width="980" height="480" as="geometry"/></mxCell>
        <mxCell id="browser" value="TRÌNH DUYỆT&#xa;Người dùng đã đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F93AE;strokeWidth=2;fontColor=#1E2E46;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="365" width="205" height="105" as="geometry"/></mxCell>
        <mxCell id="api" value="Amazon API Gateway&#xa;Nhận yêu cầu cấp URL" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#8C4FFF;strokeColor=#FFFFFF;fontColor=#232F3E;fontFamily=Arial;fontSize=14;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="500" y="315" width="90" height="90" as="geometry"/></mxCell>
        <mxCell id="lambda" value="AWS Lambda&#xa;Xác thực + tạo presigned URL" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;strokeColor=#FFFFFF;fontColor=#232F3E;fontFamily=Arial;fontSize=14;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="790" y="315" width="90" height="90" as="geometry"/></mxCell>
        <mxCell id="s3" value="Amazon S3&#xa;Bucket private" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#3F8624;strokeColor=#FFFFFF;fontColor=#232F3E;fontFamily=Arial;fontSize=14;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1120" y="445" width="90" height="90" as="geometry"/></mxCell>
        <mxCell id="note" value="Presigned URL có phạm vi và thời hạn sử dụng do backend thiết lập. Người dùng tải file trực tiếp lên S3, không cần chuyển toàn bộ nội dung file qua backend." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FC;strokeColor=#D9E2EF;fontColor=#344966;fontSize=14;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="545" width="590" height="78" as="geometry"/></mxCell>
        <mxCell id="e1" value="1. Yêu cầu URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#66778E;strokeWidth=2;fontColor=#42536B;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="2. Xác thực và ký URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#66778E;strokeWidth=2;fontColor=#42536B;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="lambda"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="3. Trả URL tạm thời" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;startArrow=block;startFill=1;endArrow=none;strokeColor=#66778E;strokeWidth=2;fontColor=#42536B;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0;entryX=0;entryY=0;" edge="1" parent="1" source="lambda" target="browser"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="835" y="230"/><mxPoint x="170" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="4. PUT file trực tiếp bằng URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3567C8;strokeWidth=3;fontColor=#244E9C;fontStyle=1;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="172" y="500"/><mxPoint x="1050" y="500"/></Array></mxGeometry></mxCell>
        <mxCell id="footer" value="Luồng cấp URL   •   Luồng upload trực tiếp" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#5D6E84;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="700" width="500" height="30" as="geometry"/></mxCell>
